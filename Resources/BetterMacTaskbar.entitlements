<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks outgoing Apple Events without this; NSAppleScript
	     drives Finder, System Events and browsers for window titles, raising,
	     closing and emptying the Trash. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Hardened runtime silently denies EventKit without this; the clock
	     flyout's Up Next list reads upcoming events. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
